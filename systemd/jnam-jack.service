[Unit]
Description=JACK2 Real-Time Audio Server for JNAM
After=sound.target

[Service]
Type=simple
User=root
Group=audio
LimitRTPRIO=95
LimitMEMLOCK=infinity
ExecStartPre=+/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g" 2>/dev/null || true; done'
ExecStart=/opt/jnam/scripts/start-jack.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
